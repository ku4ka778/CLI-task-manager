package main

import (
	"flag"
	"fmt"
	"time"
	"os"
	"encoding/json"
)

type Task struct {
	ID int64 `json:"id"`
	Name string `json:"name"`
	Description string `json:"description"`
	IsPending bool `json:"ispending"`
	Time string `json:"time"`
}

func getJsonInfo() []Task{
	var tasks []Task

	file, err := os.Open("config.json")
	if err !=nil {
		fmt.Println("Error", err)
		return tasks
	}
	defer file.Close()

	err = json.NewDecoder(file).Decode(&tasks)
	if err != nil {
		return tasks
	}
	return tasks
}

func createTask(name, description string) *Task {
	existingTasks := getJsonInfo()

	var maxID int64 = 0
	for _, t := range existingTasks {
		if t.ID > maxID {
			maxID = t.ID
		}
	}
	
	task := Task{
		ID: maxID + 1,
		Name: name,
		Description: description,
		IsPending: true,
		Time: time.Now().Format("2006-01-02 15:04:05"),
	}

	existingTasks = append(existingTasks, task)
	fmt.Println("Created:", task)

	file, err := os.Create("config.json")
	if err != nil {
		fmt.Println("Error:", err)
	}

	encoder := json.NewEncoder(file)
	encoder.SetIndent("", "    ")

	err = encoder.Encode(existingTasks)
	if err != nil {
		fmt.Println("Error:", err)
	}
	
	return &task
}

func addTask(args []string) {
	fs := flag.NewFlagSet("add", flag.ExitOnError)

	name:= fs.String("name", "", "The task name")
	description := fs.String("description", "", "The description of the task")

	err:= fs.Parse(args)
	if err !=nil {
		fmt.Println("Error", err)
		return
	}

	if *name == "" {
		fmt.Println("The name is required. Usage: task-manager add -name <name>")
		return
	}
	createTask(*name, *description)
}

func taskList() {
	var existingTasks = getJsonInfo()
	fmt.Println(existingTasks)
}

func main() {
	if len(os.Args) < 2 {
		fmt.Println("Usage: task-manager <command>")
		return
	}

	command := os.Args[1]

	switch command {
	case "add":
		addTask(os.Args[2:])
	case "list":
		taskList()
	default:
		fmt.Println("Unknown command:", command)
	}
}
